{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "exclusive-pest-v2.vercel.app"
        }
      ],
      "destination": "https://www.exclusivepest.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "exclusive-pest-v2.vercel.app"
        }
      ],
      "destination": "https://www.exclusivepest.co/:path*",
      "permanent": true
    }
  ]
}
